# Copy to .env and fill in ONE provider (or none — MCP hosts can supply the
# model via sampling, and remote users can send keys per-request in headers).

LOG_LEVEL=INFO
# Set to "json" for structured logs (recommended for hosted deployments)
LOG_FORMAT=

# --- LLM providers (set one; all optional) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=amazon.nova-pro-v1:0

# GitHub token for cloning private repos / opening docs PRs
GITHUB_TOKEN=

# --- Hardening (Phase 2) ---
MAX_CONCURRENT_PIPELINES=3
PIPELINE_TIMEOUT_S=300
MAX_REPO_MB=500
# Sandbox for local-filesystem tools; REQUIRED to enable them on hosted deployments
LOCAL_ROOT=
# Must include your public hostname when hosted, e.g. your-app.onrender.com
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,localhost:*,127.0.0.1:*
# true = never spend this server's keys on requests (hosted/public mode);
# requests bring their own key via X-Provider-API-Key or use host sampling
BYOK_ONLY=false

# --- Distribution & public access (Phase 4) ---
# HTTP transports when PORT is set: both | streamable-http | sse
MCP_TRANSPORT=both
# Per-client requests/minute on HTTP transports (0 disables)
RATE_LIMIT_RPM=20
# Size cap for docs inlined into responses via return_docs=True
MAX_INLINE_DOC_KB=300
